<div class="container-fluid" id="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-3 mt-2">

        <!-- Tab toggle -->
        <div class="btn-group" role="group">
            {{#if isPassout}}
            <a href="/students" class="btn btn-outline-primary">Active Students</a>
            <a href="/students?tc=true" class="btn btn-primary">Passout Students</a>
            {{else}}
            <a href="/students" class="btn btn-primary">Active Students</a>
            <a href="/students?tc=true" class="btn btn-outline-primary">Passout Students</a>
            {{/if}}
        </div>

        <!-- Sort -->
        <div class="dropdown">
            <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" data-toggle="dropdown">
                Sort By &nbsp;<i class="fa fa-sort"></i>
            </button>
            <div class="dropdown-menu dropdown-menu-right">
                {{#if isPassout}}
                <a class="dropdown-item" href="/students?tc=true&sort=asc">TC Date — Oldest first</a>
                <a class="dropdown-item" href="/students?tc=true&sort=desc">TC Date — Newest first</a>
                {{else}}
                <a class="dropdown-item" href="/students?sort=asc">Class — Ascending</a>
                <a class="dropdown-item" href="/students?sort=desc">Class — Descending</a>
                {{/if}}
            </div>
        </div>

    </div>

    {{#if students}}
    <table class="table table-striped">
        <thead class="thead-dark">
            <tr>
                <th>Name</th>
                <th>Gender</th>
                {{#if isPassout}}
                <th>TC Date</th>
                <th>Class</th>
                {{else}}
                <th>Date Of Admission</th>
                <th>Class</th>
                {{/if}}
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            {{#each students}}
            <tr>
                <td>{{StudentName.FirstName}}&nbsp;{{StudentName.LastName}}</td>
                <td>{{Gender}}</td>
                {{#if ../isPassout}}
                <td>{{RelievingDetails.TCDate}}</td>
                {{else}}
                <td>{{DateOfAdmission}}</td>
                {{/if}}
                <td>{{CurrentClass}}</td>
                <td>
                    <div class="dropdown">
                        <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-toggle="dropdown"></button>
                        <div class="dropdown-menu dropdown-menu-right animated fadeIn">
                            <a class="dropdown-item edit-item" href="/students/edit?id={{_id}}">Edit</a>
                            <a class="dropdown-item" href="/students/details?id={{_id}}">View</a>
                            <a href="#" class="dropdown-item del-item" onclick="deleteItem('/students/{{_id}}');">Delete</a>
                        </div>
                    </div>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>

    {{#unless user.privileges.update}}
    <script>
        document.querySelectorAll('.edit-item').forEach(function(el) { el.style.display = 'none'; });
    </script>
    {{/unless}}

    {{#unless user.privileges.delete}}
    <script>
        document.querySelectorAll('.del-item').forEach(function(el) { el.style.display = 'none'; });
    </script>
    {{/unless}}

    <br>
    <ul class="pagination">
        {{#paginate current=current pages=pages prefix=pagePrefix}} {{/paginate}}
    </ul>

    {{else}}
    <p class="text-muted mt-3">No records found.</p>
    {{/if}}

</div>

<a href="/students/add" class="float">
    <i class="fa fa-plus my-float"></i>
</a>
