<div class="container-fluid" id="container-fluid">
<br>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Exam Calendar</h4>
    <a href="/courses" class="btn btn-outline-secondary btn-sm">
        <i class="fa fa-arrow-left"></i> Back to Courses
    </a>
</div>

{{#if schedule.length}}
<div class="card mb-4">
    <div class="card-header py-2"><strong>All Exams — Sorted by Date</strong></div>
    <div class="card-body p-0">
        <table class="table table-sm table-striped table-bordered mb-0">
            <thead class="thead-dark">
                <tr>
                    <th>Date</th>
                    <th>Subject</th>
                    <th>Class</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {{#each schedule}}
                <tr>
                    <td><strong>{{examDate}}</strong></td>
                    <td>{{subject}}</td>
                    <td>{{className}}</td>
                    <td>
                        <a href="/courses/edit?id={{courseId}}" class="btn btn-xs btn-outline-primary btn-sm">Edit</a>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>
{{else}}
<div class="alert alert-info">No exam dates have been set yet. Open a course to add exam dates.</div>
{{/if}}

<h5 class="mb-3">By Class</h5>
{{#each courses}}
{{#if subjects.length}}
<div class="card mb-3">
    <div class="card-header py-2 d-flex justify-content-between align-items-center">
        <strong>{{displayName}}</strong>
        <a href="/courses/edit?id={{_id}}" class="btn btn-sm btn-outline-primary">Edit Schedule</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-sm mb-0">
            <thead class="thead-light">
                <tr>
                    <th>Subject</th>
                    <th>Exam Date</th>
                    <th>Type</th>
                </tr>
            </thead>
            <tbody>
                {{#each subjects}}
                <tr>
                    <td>{{name}}</td>
                    <td>
                        {{#if examDate}}
                        <span>{{examDate}}</span>
                        {{else}}
                        <span class="text-muted">Not set</span>
                        {{/if}}
                    </td>
                    <td><span class="badge badge-secondary">{{markingType}}</span></td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>
{{/if}}
{{/each}}
</div>
